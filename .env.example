# --- Chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
# Comma-separated quote-token addresses (e.g. WETH, stablecoins). In a new pool the
# token NOT in this list is treated as the memecoin. Leave empty to default to token0.
QUOTE_TOKENS=

# --- Polling ---
POLL_INTERVAL_SECONDS=5
# First block to scan. Empty = start from the current head.
START_BLOCK=
# Max block span per eth_getLogs request (lower it if your RPC rejects ranges).
MAX_BLOCK_RANGE=2000
# New pools usually have no liquidity yet; re-check them for this many polls
# before giving up and skipping.
MAX_PENDING_POLLS=20

# --- Risk thresholds ---
# Minimum in-range pool liquidity (raw Uniswap V3 `liquidity()` units).
MIN_LIQUIDITY=1000000
# Minimum decision confidence (0-1) required to act on a "buy".
MIN_CONFIDENCE=0.7
# Maximum heuristic risk score (0-100) allowed for a "buy".
MAX_RISK_SCORE=60

# --- Paper trading ---
PAPER_POSITION_SIZE=0.05
POSITIONS_FILE=data/positions.jsonl
